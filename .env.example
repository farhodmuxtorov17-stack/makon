# ============================================
# MAKON Environment Variables
# ============================================
# Copy this file to .env and fill in values
# cp .env.example .env

# --- API ---
# Base44 backend functions URL (v1.1+)
NUXT_PUBLIC_API_BASE=https://solene-7d68319d.base44.app/functions

# --- ERI Integration (v1.1+) ---
# ERI API endpoint for electronic document signatures
ERI_API_URL=https://eri.uz/api/v1
ERI_API_KEY=your_eri_api_key_here
ERI_CALLBACK_URL=https://makon.uz/eri/callback

# --- App ---
# App URL (for ERI callbacks, CORS)
APP_URL=https://farhodmuxtorov17-stack.github.io/makon/

# --- Telegram Mini App ---
# Telegram bot token (for Mini App)
TG_BOT_TOKEN=your_telegram_bot_token
TG_WEBAPP_URL=https://farhodmuxtorov17-stack.github.io/makon/

# --- Analytics (optional, v1.2+) #
# Google Analytics 4 Measurement ID
GA_MEASUREMENT_ID=

# --- Build ---
# Node environment
NODE_ENV=production
