{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"]
    },
    "types": ["node", "nuxt"]
  },
  "include": ["**/*.ts", "**/*.vue", "**/*.js", ".nuxt/types/**/*.d.ts", "nuxt.config.ts"],
  "exclude": ["node_modules", ".output", ".nuxt"]
}
